# Copy to `.env.local` and fill in real values. NEVER commit a filled-in copy.
#
# Where each value is used:
#   NEXT_PUBLIC_*  compiled into the browser bundle at BUILD time. Must be passed
#                  as --build-arg to `docker build`, and set as App Runner build
#                  variables. Public by design.
#   everything else  read at RUN time only. Server-side secrets.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Public by design; row-level security constrains it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY. Bypasses row-level security entirely.
# Never expose this to the browser and never place it in a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Public origin used for OAuth redirects and e-mail links. Must exactly match an
# entry in Supabase -> Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Feature and debug switches (keep disabled outside local development)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_DEV_BYPASS_AUTH=false
AUTH_OAUTH_DEBUG=0
ALLOW_LOCAL_SUPABASE=false

# Shared-hosting compatibility: disables Next.js dynamic image optimisation.
NEXT_IMAGE_UNOPTIMIZED=false

# ---------------------------------------------------------------------------
# PDF export (Chromium)
# ---------------------------------------------------------------------------

# In the Docker image this is set to /usr/bin/chromium automatically.
# Set it locally only if Chrome is somewhere unusual.
# PUPPETEER_EXECUTABLE_PATH=

# Local-only overrides for how the procurement PDF finds a browser.
# PROCUREMENT_PDF_USE_LOCAL_CHROME=true
# PROCUREMENT_PDF_FORCE_SERVERLESS_CHROMIUM=true
