# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local-only copies of QA workbooks (tracked canonical file lives under src/**/__tests__/fixtures/)
/full_scorecard_upload_test_workbook.xlsx

# Client confidential inputs and local verification (never commit raw supplier data)
/client-inputs/
image001.jpg
BBBEE Spend Report.xlsx
BBBEE Spend Report(1).xlsx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Supabase CLI local state (never commit)
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify
/tmp/
tmp/

# Staging smoke evidence and local fixtures (may contain beneficiary names / secrets)
# Explicit aliases (already covered by tmp/ above — kept for runbook clarity)
/tmp/staging-secrets/
/tmp/full-scorecard-reference/
tmp/staging-secrets/
tmp/full-scorecard-reference/

# Build/QA artifacts: screenshots, smoke output, verification dumps.
# Regenerated on demand; kept out of git so history stops growing.
/artifacts/
